# Copy to .env.local for local testing; set the same names in Vercel → Settings → Environment Variables.
# Every block is optional: the site builds and runs without it, and the feature switches itself on once set.

# --- Accounts (Supabase → Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- Payments (Stripe → Developers) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) of the two recurring prices on the "DSLR Snap" product.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Optional: extra booth computers ($5/month and $50/year). Without them, "Add a computer" is hidden.
STRIPE_PRICE_EXTRA_COMPUTER_MONTHLY=
STRIPE_PRICE_EXTRA_COMPUTER_YEARLY=
# 1 to let Stripe Tax add VAT / sales tax at checkout (turn Stripe Tax on first).
STRIPE_AUTOMATIC_TAX=0

# --- Booth licences: node scripts/generate-licence-keys.mjs ---
LICENCE_PRIVATE_KEY=

# --- Gallery clean-up (Vercel cron): any long random string ---
CRON_SECRET=

# --- Email (Resend → resend.com, verify the dslrsnap.com domain) ---
RESEND_API_KEY=
# Sender for every email (default "DSLR Snap <hello@dslrsnap.com>") and where team notices go (default support@).
EMAIL_FROM=
TEAM_EMAIL=
# Supabase → Authentication → Hooks → Send Email (HTTPS, URL https://dslrsnap.com/api/auth/email-hook):
# the "v1,whsec_…" secret Supabase shows. Then sign-up and password emails use DSLR Snap's design.
SEND_EMAIL_HOOK_SECRET=
# Where form messages go (default support@dslrsnap.com) and the sender address.
CONTACT_TO=
CONTACT_FROM=

# --- Marketing ---
# Google Search Console → HTML tag method → the content="…" value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Only for local testing of email links and Stripe redirects, e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# --- Admin (node scripts/generate-admin.mjs prints these) ---
# The private address of the admin, e.g. a long random word. /admin itself always answers "not found".
# Never put it in code: the repository can be read.
ADMIN_PATH=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
ADMIN_SESSION_SECRET=

# --- Email replies into the support chat (optional; see docs/ACCOUNTS_SETUP.md) ---
# The domain Resend receives on, e.g. reply.dslrsnap.com (MX records from Resend → Domains).
INBOUND_REPLY_DOMAIN=
# Resend → Webhooks → endpoint https://dslrsnap.com/api/email/inbound, event email.received: the "whsec_…" secret.
RESEND_INBOUND_WEBHOOK_SECRET=
# A full-access Resend key (the sending key can't read received mail).
RESEND_RECEIVING_API_KEY=
# Extra addresses allowed to answer as the team by email (comma-separated), e.g. your own Gmail.
INBOUND_TEAM_SENDERS=

# --- Gallery storage on Cloudflare R2 (optional; default is Supabase Storage) ---
# A private bucket (e.g. dslrsnap-photos) and an API token with Object Read & Write on it.
# Set GALLERY_R2_JURISDICTION=eu for an EU-jurisdiction bucket.
GALLERY_R2_ACCOUNT_ID=
GALLERY_R2_ACCESS_KEY_ID=
GALLERY_R2_SECRET_ACCESS_KEY=
GALLERY_R2_BUCKET=
GALLERY_R2_JURISDICTION=
