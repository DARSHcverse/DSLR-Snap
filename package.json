{
  "name": "snapdesk-booth",
  "productName": "SnapDesk Booth",
  "version": "0.1.0",
  "description": "Windows photo booth application for event operators (working name)",
  "main": "./out/main/index.js",
  "author": "Darshan Subramaniam",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "render-samples": "vitest run tests/renderSamples.test.ts",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3": "^13.0.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
