# Build-time settings for the app (read by electron-vite when you run `npm run dev` / `npm run build`).
# Copy to .env in the repo root. Leave empty while developing: licensing stays off in dev builds.

# Website the app signs in with (default https://dslrsnap.com). Use a Vercel preview URL to test.
MAIN_VITE_ACCOUNT_URL=
# Public half of the licence key pair: website/scripts/generate-licence-keys.mjs
MAIN_VITE_LICENCE_PUBLIC_KEY=

# Runtime settings (cloud gallery) are read from .env in the app data folder; see README.

# Releases (npm run release): Cloudflare R2 → Manage API tokens → Object Read & Write on the bucket.
# Only on the computer that publishes releases; never shipped inside the app.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
